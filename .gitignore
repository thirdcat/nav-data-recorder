# Generated by XcodeGen — never committed, regenerated in CI and locally
*.xcodeproj
*.xcworkspace

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Signing material — MUST NOT be committed. Keep these in CI env vars only.
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision

# macOS
.DS_Store

# Local captures pulled off-device for inspection
/captures/
