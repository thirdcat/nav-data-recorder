# Generated by XcodeGen — never committed, regenerated in CI and locally
*.xcodeproj
*.xcworkspace

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Signing material — MUST NOT be committed. Keep these in CI env vars only.
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision

# macOS
.DS_Store

# Local captures pulled off-device for inspection
/captures/

# What the tools write when pointed at a session. Same reasoning as /captures/:
# derived from data that is not in the repo, regenerable in one command, and
# large — the episode exporter alone writes a JPEG per frame.
/episodes/
/tools/episodes/
/ultra_rectified/
/ultra_rectified_uncorrected/

# Python bytecode from the tools/
__pycache__/
*.pyc

# eval/ builds these per machine: one is a CUDA-specific environment, the
# other belongs to upstream and is pinned by commit in eval/setup.sh.
eval/.venv/
eval/vendor/
traj/
pi3traj/
pi3out/
pi3win/
brief_codex_fusion.md

# Written by eval/fuse_rate.py --out, gated by its convention_gate.
fusedtraj/

# logs/: experiment records. Only the text that a plan-document link points at
# is committed — README, protocol and summary. Renders, checkpoints, per-arm
# dumps and Pi3X caches beside them are large and regenerable from the README.
/logs/**
!/logs/**/
!/logs/**/README.md
!/logs/**/protocol*.json
!/logs/**/summary*.json
