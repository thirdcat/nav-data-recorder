# Generated by XcodeGen — never committed, regenerated in CI and locally
*.xcodeproj
*.xcworkspace

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Signing material — MUST NOT be committed. Keep these in CI env vars only.
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision

# macOS
.DS_Store

# Local captures pulled off-device for inspection
/captures/

# What the tools write when pointed at a session. Same reasoning as /captures/:
# derived from data that is not in the repo, regenerable in one command, and
# large — the episode exporter alone writes a JPEG per frame.
/episodes/
/tools/episodes/
/ultra_rectified/
/ultra_rectified_uncorrected/

# Python bytecode from the tools/
__pycache__/
*.pyc
